# ─────────────────────────────────────────────────────────────────────
# Duplex Bot — Voice Agent SaaS
#
# ZERO-CONFIG: With NO .env at all, the app boots a single container using an
# embedded SQLite database + auto-generated secret key under ./data. Tenants
# then bring their own provider keys per-agent through the UI. Everything below
# is optional — set only what you need.
# ─────────────────────────────────────────────────────────────────────

# ── Deployment / persistence ─────────────────────────────────────────
# All mutable state (SQLite DB, secret key, uploaded files) lives here.
# Mount a volume at this path to persist across container restarts.
DATA_DIR=data
# Leave DATABASE_URL empty to use embedded SQLite (recommended for single
# container). Set it to a managed Postgres to scale out — the same image is
# portable across clouds. postgres:// and postgresql:// DSNs are auto-normalized.
# DATABASE_URL=
# Leave SECRET_KEY empty to auto-generate + persist one under DATA_DIR. Set it
# explicitly in production and share it across replicas (signs JWTs + encrypts
# stored provider credentials).
# SECRET_KEY=
# Comma-separated allowed origins, or "*". Not needed when the SPA is served
# from the same origin (the default single-container setup).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Auth / multi-tenancy ─────────────────────────────────────────────
AUTH__ALLOW_SIGNUP=true
AUTH__FIRST_USER_IS_ADMIN=true
# AUTH__ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─────────────────────────────────────────────────────────────────────
# The values below are PLATFORM DEFAULTS. Tenants normally override provider
# keys per-agent in the UI (stored encrypted). Set these only if you want a
# shared fallback for agents that don't specify their own.
# ─────────────────────────────────────────────────────────────────────

# Azure Speech Services (STT + TTS)
AZURE_SPEECH__SUBSCRIPTION_KEY=
AZURE_SPEECH__REGION=eastus
AZURE_SPEECH__AUTH_MODE=key
AZURE_STT__LANGUAGE=en-US
AZURE_TTS__VOICE_NAME=en-US-JennyNeural

# ElevenLabs TTS
ELEVENLABS__API_KEY=
ELEVENLABS__VOICE_ID=
ELEVENLABS__MODEL_ID=eleven_turbo_v2_5

# LLM (OpenAI-compatible)
LLM__BASE_URL=https://api.openai.com/v1
LLM__API_KEY=
LLM__MODEL=gpt-4o
LLM__TEMPERATURE=0.7
LLM__MAX_TOKENS=1024

# Langfuse observability (optional)
LANGFUSE__PUBLIC_KEY=
LANGFUSE__SECRET_KEY=
LANGFUSE__HOST=https://cloud.langfuse.com
LANGFUSE__ENABLED=false

# Server
HOST=0.0.0.0
PORT=8000

# Default system prompt for agents that don't set their own
SYSTEM_PROMPT=You are a helpful voice assistant. Keep your responses concise and conversational.
