# Local split-dev only. In the single-container production build the SPA is
# served by the backend on the same origin, so these are auto-derived and you
# do NOT need to set them.
#
# For `next dev` against a separately-running backend on :8000:
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_WS_URL=ws://localhost:8000/ws/browser
