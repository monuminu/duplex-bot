# Azure Speech Services (STT + TTS)
AZURE_SPEECH__SUBSCRIPTION_KEY=your-azure-speech-key
AZURE_SPEECH__REGION=eastus

# Azure STT specific
AZURE_STT__LANGUAGE=en-US

# Azure TTS specific
AZURE_TTS__VOICE_NAME=en-US-JennyNeural

# ElevenLabs TTS
ELEVENLABS__API_KEY=your-elevenlabs-key
ELEVENLABS__VOICE_ID=your-voice-id
ELEVENLABS__MODEL_ID=eleven_turbo_v2_5

# LLM (OpenAI-compatible)
LLM__BASE_URL=https://api.openai.com/v1
LLM__API_KEY=your-openai-key
LLM__MODEL=gpt-4o
LLM__TEMPERATURE=0.7
LLM__MAX_TOKENS=1024

# Langfuse observability
LANGFUSE__PUBLIC_KEY=your-langfuse-public-key
LANGFUSE__SECRET_KEY=your-langfuse-secret-key
LANGFUSE__HOST=https://cloud.langfuse.com

# Server
HOST=0.0.0.0
PORT=8000

# System prompt
SYSTEM_PROMPT=You are a helpful voice assistant. Keep your responses concise and conversational.
